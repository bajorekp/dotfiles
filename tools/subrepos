#!/bin/bash

# if first argument is "dirty", show only dirty subrepos
if [ "$1" = "dirty" ]; then
  for d in */; do
    [ -d "$d/.git" ] || continue
    ( cd "$d" && [ -n "$(git status --porcelain)" ] && printf "%-40s %-20s %s\n" \
      "${d%/}" \
      "$(git symbolic-ref --short -q HEAD 2>/dev/null || echo "DETACHED@$(git rev-parse --short HEAD)")" \
      "$( [ -n "$(git status --porcelain)" ] && echo dirty || echo clean )"
    )
  done
  exit 0
fi

# if first argument is "status", show status of all subrepos
if [ "$1" = "status" ]; then
  for d in */; do
    [ -d "$d/.git" ] || continue
    ( cd "$d" && printf "%-40s %-20s %s\n" \
      "${d%/}" \
      "$(git symbolic-ref --short -q HEAD 2>/dev/null || echo "DETACHED@$(git rev-parse --short HEAD)")" \
      "$( [ -n "$(git status --porcelain)" ] && echo dirty || echo clean )"
    )
  done

  exit 0
fi

# if the first argument is "update", update all subrepos in parallel
if [ "$1" = "update" ]; then
  prefix_output() {
    local prefix="$1"
    while IFS= read -r line; do
      echo "${prefix}${line}"
    done
  }

  run_with_prefix() {
    local prefix="$1"; shift
    if [[ "$1" == "--" ]]; then shift; fi

    echo -e "\033[1m$prefix \$ $*\033[0m"
    {
      "$@" 2> >(while IFS= read -r line; do
        printf "\033[31m%s %s\033[0m\n" "$prefix" "$line"   # red for stderr
      done >&2)
    } | while IFS= read -r line; do
        printf "%s %s\n" "$prefix" "$line"                   # normal for stdout
      done
  }



  for d in */; do
    if [ -d "$d/.git" ]; then
      pushd "$d" > /dev/null
        # echo "=== $d ==="
        if [ "$(git symbolic-ref --short -q HEAD 2>/dev/null)" != "master" ]; then
          run_with_prefix "[$d]" -- git checkout master
        fi
        if [ "$(git symbolic-ref --short -q HEAD 2>/dev/null)" = "master" ]; then
          (run_with_prefix "[$d]" -- git pull) &
        fi
      popd > /dev/null
    fi
  done

  wait
  echo "All jobs completed."

  # Runs the program again with status summary
  $0 status

  exit 0
fi

# if the first argument is "open-pulls", open the pull request page for each subrepo
if [ "$1" = "open-pulls" ]; then
  for d in */; do
    [ -d "$d/.git" ] || continue
    # open pull request page in default browser
    ( cd "$d" && git remote get-url origin) | sed -e 's/\.git$//' -e 's/^git@/https:\/\//' | xargs -I {} echo "{}/pulls" | cat
  done
  exit 0
fi

# if the first argument is "show-pulls", show open pull requests
if [ "$1" = "show-pulls" ]; then
  for d in */; do
    [ -d "$d/.git" ] || continue
    now=$(date +%s)
    repo_name=${d%/}

    # print repo name in bold
    echo -e "\033[1m=== $repo_name ===\033[0m"

    # list open pull requests using gh cli and format output using jq in tsv format
    gh pr list --repo "AirHelp/$repo_name" --state open \
        --json number,title,url,headRefName,createdAt,mergeable --template '
      {{- range . -}}
        {{- $age := (timeago .createdAt) -}}
        {{- $link := (hyperlink .url (printf "#%v - %s" .number .title)) -}}
        {{- if eq .mergeable "MERGEABLE" -}}
          {{- tablerow (autocolor "green" $age)  $link  .headRefName -}}
        {{- else if eq .mergeable "CONFLICTING" -}}
          {{- tablerow (autocolor "red" $age)    $link  .headRefName -}}
        {{- else -}}
          {{- tablerow (autocolor "yellow" $age) $link  .headRefName -}}
        {{- end -}}
      {{- end -}}'
    echo ""
  done;
  exit 0
fi;

# if the first argument is "show-pulls-with-actions", show open pull requests
if [ "$1" = "show-pulls-with-actions" ]; then
  for d in */; do
    [ -d "$d/.git" ] || continue
    now=$(date +%s)
    repo_name=${d%/}

    # print repo name in bold
    echo -e "\033[1m=== $repo_name ===\033[0m"

    # list open pull requests using gh cli and format output using jq in tsv format
    gh pr list --repo "AirHelp/$repo_name" --state open \
      --json number,title,url,headRefName,createdAt,mergeable,statusCheckRollup --template '
    {{- range . -}}
      {{- $age := (timeago .createdAt) -}}
      {{- $link := (hyperlink .url (printf "#%v - %s == %s ==" .number .title .headRefName)) -}}

      {{- /* Main PR row: [Col1] title  [Col2] branch  [Col3] age */ -}}
      {{- tablerow $age $link -}}

      {{- /* Checks under the title: put text entirely in Col1; Col2+Col3 empty */ -}}
      {{- if gt (len .statusCheckRollup) 0 -}}
        {{- range .statusCheckRollup -}}
          {{- $badge := "" -}}
          {{- if ne .status "COMPLETED" -}}
            {{- $badge = (autocolor "yellow" "🕒 PENDING") -}}
          {{- else if eq .conclusion "SUCCESS" -}}
            {{- $badge = (autocolor "green" "✅ SUCCESS") -}}
          {{- else if or (eq .conclusion "FAILURE") (eq .conclusion "TIMED_OUT") (eq .conclusion "STARTUP_FAILURE") -}}
            {{- $badge = (autocolor "red" "❌ FAILURE") -}}
          {{- else if or (eq .conclusion "CANCELLED") (eq .conclusion "SKIPPED") (eq .conclusion "NEUTRAL") -}}
            {{- $badge = (autocolor "magenta" (printf "⏭ %s" .conclusion)) -}}
          {{- else -}}
            {{- $badge = (autocolor "yellow" (printf "⚠️ %s" .conclusion)) -}}
          {{- end -}}
          {{- tablerow "" (printf "  • %s  %s" $badge (hyperlink .detailsUrl .name)) -}}
        {{- end -}}
      {{- else -}}
        {{- tablerow "" (autocolor "yellow" "  • ⚪ No checks") -}}
      {{- end -}}

      {{- /* Spacer row between PRs */ -}}
      {{- tablerow "" "" -}}
    {{- end -}}'

    echo ""
  done;
  exit 0
fi;





echo "Usage: $0 [dirty|status|update]"
