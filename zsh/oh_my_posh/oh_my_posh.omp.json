{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "background": "#18354c",
    "foreground": "#cfa938"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": " \uf0e7 ",
          "foreground": "p:background",
          "background": "p:foreground",
          "type": "root",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4 ",
          "template": " {{ if eq .Code 0 }}✓{{ else }}{{ .Meaning }} ({{.Code}}){{ end }} ",
          "foreground": "#ffffff",
          "background": "#00897b",
          "type": "exit",
          "style": "diamond",
          "background_templates": [
            "{{ if ne .Code 0 }}#e91e63{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "style": "agnoster_full"
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "template": " \uf74a  {{ .Path }} ",
          "foreground": "p:foreground",
          "background": "p:background",
          "type": "path",
          "style": "diamond"
        },
        {
          "properties": {
            "always_enabled": false,
            "cache_duration": "none",
            "style": "amarillo",
            "threshold": 500
          },
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b6",
          "template": " {{ .FormattedMs }} ",
          "foreground": "p:background",
          "powerline_symbol": "\ue0b0",
          "background": "p:foreground",
          "type": "executiontime",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_identical_icon": "=",
            "branch_max_length": 25,
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": false
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }} ",
          "foreground": "p:background",
          "powerline_symbol": "\ue0b0",
          "background": "#579e61",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#cfa938{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#579e9e{{ end }}",
            "{{ if gt .Behind 0 }}#9da8a8{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "❯",
          "foreground": "#ffffff",
          "type": "exit",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff0000{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
